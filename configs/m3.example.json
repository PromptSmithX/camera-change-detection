{
  "source": {
    "type": "image_sequence",
    "path": "data/raw/cdnet 2014/intermittentObjectMotion/abandonedBox/input",
    "source_id": "cdnet2014_abandonedbox",
    "frame_pattern": "in*.jpg",
    "fps": 25.0
  },
  "roi": {
    "type": "bbox",
    "path": "data/benchmark/v2/roi/cdnet2014_abandonedbox.json"
  },
  "calibration": {
    "sample_count": 10,
    "sample_interval_seconds": 0.2,
    "start_frame": 280
  },
  "runtime": {
    "processing_fps": 5.0
  },
  "perception": {
    "enabled": true,
    "detector": {
      "model": "weights/yolov8s.pt",
      "confidence": 0.35,
      "iou": 0.7,
      "device": "0",
      "classes": null,
      "max_detections": 300
    },
    "tracker": {
      "track_activation_threshold": 0.25,
      "lost_track_buffer": 30,
      "minimum_matching_threshold": 0.8,
      "minimum_consecutive_frames": 1
    },
    "encoder": {
      "enabled": true,
      "name": "dinov2",
      "model": "dinov2_vits14",
      "repository": "facebookresearch/dinov2",
      "device": "0",
      "input_size": 224,
      "batch_size": 8,
      "semantic_refresh_fps": 2.5,
      "crop_padding_ratio": 0.1
    }
  },
  "association": {
    "appearance_weight": 0.5,
    "spatial_weight": 0.2,
    "size_weight": 0.15,
    "class_weight": 0.15,
    "min_appearance_similarity": 0.65,
    "min_total_score": 0.7,
    "ambiguity_margin": 0.05,
    "require_same_class": true,
    "max_reid_seconds": 3.0
  },
  "memory": {
    "missing_grace_seconds": 1.0,
    "observation_history_size": 30,
    "embedding_history_size": 10
  },
  "baseline": {
    "path": "runs/m3/baseline/baseline.json"
  }
}
